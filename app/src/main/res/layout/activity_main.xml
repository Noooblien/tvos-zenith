<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tvos_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top Shelf Cinematic Hero Container (Pixel-aligned with Dock) -->
    <org.zenith.tvos.ui.topshelf.TopShelfHeroView
        android:id="@+id/topShelfHero"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginTop="20dp"
        android:clipChildren="false" />

    <!-- Top-Right Utility Controls (Phone Remote & Zenith Settings) -->
    <LinearLayout
        android:id="@+id/topUtilityBar"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="68dp"
        android:layout_marginRight="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPhoneRemote"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_category_pill"
            android:focusable="true"
            android:nextFocusRight="@+id/btnZenithSettings"
            android:nextFocusDown="@+id/btnTopShelfPlay"
            android:paddingHorizontal="14dp"
            android:text="📱 Phone Remote"
            android:textAllCaps="false"
            android:textColor="@color/tvos_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnZenithSettings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_category_pill"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnPhoneRemote"
            android:nextFocusDown="@+id/btnTopShelfPlay"
            android:paddingHorizontal="14dp"
            android:text="⚙️ Settings"
            android:textAllCaps="false"
            android:textColor="@color/tvos_text_primary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- tvOS Category Filter Pills Bar (Pixel-aligned with Dock) -->
    <HorizontalScrollView
        android:id="@+id/categoryPillsScroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/topShelfHero"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/categoryPillsLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pillFavorites"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_category_pill"
                android:focusable="true"
                android:nextFocusUp="@+id/btnTopShelfPlay"
                android:nextFocusDown="@+id/appRecyclerView"
                android:paddingHorizontal="16dp"
                android:text="⭐ Favorites"
                android:textAllCaps="false"
                android:textColor="@color/tvos_text_primary"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/pillAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_category_pill"
                android:focusable="true"
                android:nextFocusUp="@+id/btnTopShelfPlay"
                android:nextFocusDown="@+id/appRecyclerView"
                android:paddingHorizontal="16dp"
                android:text="All Apps"
                android:textAllCaps="false"
                android:textColor="@color/tvos_text_primary"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/pillStreaming"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_category_pill"
                android:focusable="true"
                android:nextFocusUp="@+id/btnTopShelfPlay"
                android:nextFocusDown="@+id/appRecyclerView"
                android:paddingHorizontal="16dp"
                android:text="Streaming"
                android:textAllCaps="false"
                android:textColor="@color/tvos_text_primary"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/pillMusic"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_category_pill"
                android:focusable="true"
                android:nextFocusUp="@+id/btnTopShelfPlay"
                android:nextFocusDown="@+id/appRecyclerView"
                android:paddingHorizontal="16dp"
                android:text="Music"
                android:textAllCaps="false"
                android:textColor="@color/tvos_text_primary"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/pillGaming"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_category_pill"
                android:focusable="true"
                android:nextFocusUp="@+id/btnTopShelfPlay"
                android:nextFocusDown="@+id/appRecyclerView"
                android:paddingHorizontal="16dp"
                android:text="Games"
                android:textAllCaps="false"
                android:textColor="@color/tvos_text_primary"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/pillTools"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_category_pill"
                android:focusable="true"
                android:nextFocusUp="@+id/btnTopShelfPlay"
                android:nextFocusDown="@+id/appRecyclerView"
                android:paddingHorizontal="16dp"
                android:text="Tools"
                android:textAllCaps="false"
                android:textColor="@color/tvos_text_primary"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/pillSystem"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_category_pill"
                android:focusable="true"
                android:nextFocusUp="@+id/btnTopShelfPlay"
                android:nextFocusDown="@+id/appRecyclerView"
                android:paddingHorizontal="16dp"
                android:text="System"
                android:textAllCaps="false"
                android:textColor="@color/tvos_text_primary"
                android:textSize="12.5sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Focused App Title / Reorder Status Indicator -->
    <TextView
        android:id="@+id/focusedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/dockContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text=""
        android:textColor="@color/tvos_text_primary"
        android:textSize="15sp"
        android:alpha="0.85" />

    <!-- Frosted Bottom Dock / App Drawer Container (Pixel-aligned with Top Shelf) -->
    <FrameLayout
        android:id="@+id/dockContainer"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginLeft="48dp"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_frosted_dock"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nextFocusUp="@+id/pillFavorites"
            android:descendantFocusability="afterDescendants"
            android:overScrollMode="never" />

    </FrameLayout>

</RelativeLayout>
