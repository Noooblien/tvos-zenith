<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="460dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_context_menu"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Zenith TV Preferences"
        android:textColor="@color/tvos_text_primary"
        android:textSize="19.5sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"
        android:text="Customize visual themes, tactile audio, HUD telemetry, and parental guard"
        android:textColor="@color/tvos_text_secondary"
        android:textSize="11.5sp" />

    <Button
        android:id="@+id/btnSettingWallpaper"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="🎨 Wallpaper: Dynamic per Category"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSettingTopShelfCycle"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="🎬 Top Shelf Showcase Carousel: ON"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSettingSound"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="🔊 Tactile Audio Clicks: ON"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSettingHud"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="📊 60FPS &amp; RAM Telemetry HUD: OFF"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSmartRamBoost"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="⚡ Smart RAM Boost (Trim Cache &amp; Free Memory)"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnChangeParentalPin"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="🔐 Change Parental PIN (0 Locked)"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSettingScreensaver"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="🌙 Ambient Screensaver: 2 Minutes"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnPreviewScreensaver"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="✨ Start Aerial Screensaver Now"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnUnhideAll"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_menu_item"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="👁️ Restore Hidden Apps (0)"
        android:textAllCaps="false"
        android:textColor="@color/tvos_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnCloseSettings"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pill_button_primary"
        android:focusable="true"
        android:text="Done"
        android:textAllCaps="false"
        android:textColor="#0B0E14"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
